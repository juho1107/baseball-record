# Supabase public configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_change-me

# Server-only key. Never expose this value to browser code.
SUPABASE_SECRET_KEY=sb_secret_change-me

# UniquePlay administrator login used only by server-side sync scripts.
UNIQUEPLAY_LOGIN_ID=manager@example.com
UNIQUEPLAY_LOGIN_PASSWORD=change-me

# Set only when the local Edge installation path differs from the default.
# UNIQUEPLAY_BROWSER_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
